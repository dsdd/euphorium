{
    "insertFinalNewline": true,
    "semi": true,
    "singleQuote": false,
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 80,
    "sortPackageJson": false,
    "ignorePatterns": ["rodio/**"],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.jsonc"],
            "options": {
                "trailingComma": "none"
            }
        }
    ]
}
